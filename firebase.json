{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".gitignore",
      ".git/**",
      ".firebase/**",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**",
      "*.md",
      "prompt_*.txt"
    ],
    "headers": [
      {
        "source": "/@(index.html|sw.js|manifest.json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
